{
  "name": "gemini-neon-film",
  "version": "1.0.0",
  "private": true,
  "description": "Gemini 4 Neon concept film (Remotion)",
  "scripts": {
    "prep": "node scripts/prep.mjs",
    "studio": "remotion studio src/index.ts",
    "stills": "node scripts/stills.mjs",
    "render:16x9": "remotion render src/index.ts GeminiNeon16x9 out/gemini-neon-16x9.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --muted --concurrency=50%",
    "render:9x16": "remotion render src/index.ts GeminiNeon9x16 out/gemini-neon-9x16.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --muted --concurrency=50%",
    "render": "npm run render:16x9 && npm run render:9x16",
    "verify": "node scripts/verify.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.546",
    "@remotion/cli": "4.0.546",
    "@remotion/renderer": "^4.0.546",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.546"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "geist": "^1.9.2",
    "typescript": "5.8.3"
  }
}
